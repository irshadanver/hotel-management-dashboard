# Backend API base URL (required when NEXT_PUBLIC_USE_MOCK_DATA=false)
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# Use mock data locally (default: true)
NEXT_PUBLIC_USE_MOCK_DATA=true

# Demo session timeouts (localStorage). After max hours or idle minutes, user must sign in again.
# NEXT_PUBLIC_SESSION_MAX_HOURS=12
# NEXT_PUBLIC_SESSION_IDLE_MINUTES=30
